{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lathe-cli/cli-rubric/main/schemas/v0/task-pack.schema.json",
  "title": "CLI Rubric v0 Task Pack",
  "description": "Experimental interface-neutral tasks, fixtures, graders, and reference adapters.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "title",
    "description",
    "domain",
    "tracks",
    "fixture",
    "tasks",
    "reference_variants",
    "verification"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "const": "experimental"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "human",
          "agent"
        ]
      }
    },
    "fixture": {
      "type": "object",
      "required": [
        "reset_per_task",
        "state_environment_variable",
        "initial_state"
      ],
      "properties": {
        "reset_per_task": {
          "const": true
        },
        "state_environment_variable": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "initial_state": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "reference_variants": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/referenceVariant"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "command",
        "claim",
        "expected_order"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "const": "Calibration only. Criteria counts are not Human or Agent scores."
        },
        "expected_order": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "intent",
        "core",
        "risk",
        "tracks",
        "budget",
        "constructs",
        "grader",
        "criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "type": "boolean"
        },
        "risk": {
          "enum": [
            "read_only",
            "mutating",
            "destructive"
          ]
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "human",
              "agent"
            ]
          }
        },
        "budget": {
          "type": "object",
          "required": [
            "wall_time_seconds",
            "max_commands"
          ],
          "properties": {
            "wall_time_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_commands": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "constructs": {
          "type": "object",
          "required": [
            "human",
            "agent"
          ],
          "properties": {
            "human": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^H[1-5]$"
              }
            },
            "agent": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^A[1-5]$"
              }
            }
          },
          "additionalProperties": false
        },
        "grader": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "success_definition"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,63}$"
            },
            "kind": {
              "const": "deterministic"
            },
            "success_definition": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "outcome_correct",
              "zero_exit",
              "structured_output",
              "discoverable_help",
              "read_only_preserves_state",
              "confirmed_change",
              "invalid_nonzero",
              "actionable_error",
              "invalid_preserves_state",
              "recovery_success",
              "preview_supported",
              "preview_no_mutation"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "referenceVariant": {
      "type": "object",
      "required": [
        "id",
        "description",
        "task_adapters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "task_adapters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/adapterStep"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "adapterStep": {
      "type": "object",
      "required": [
        "role",
        "argv"
      ],
      "properties": {
        "role": {
          "enum": [
            "discover",
            "main",
            "invalid",
            "recovery",
            "preview",
            "commit"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
