{
  "$schema": "https://raw.githubusercontent.com/lathe-cli/cli-rubric/main/schemas/v0/profile.schema.json",
  "schema_version": "0.1.0",
  "id": "three-cli-agent-pilot-v0",
  "version": "0.1.0",
  "status": "experimental",
  "track": "agent",
  "description": "Single-session protocol rehearsal on three fixed real CLI artifacts. Results are always unscored.",
  "scope": {
    "claim": "Test whether matched discovery, recovery, preview, confirmation, and cleanup observations can be collected reproducibly. Do not estimate general Agent performance or compare subjects by score.",
    "cli_class": "hybrid",
    "capability_domain": "matched cross-domain resource lifecycle",
    "interaction_risk": [
      "read_only",
      "mutating",
      "destructive"
    ],
    "setup_boundary": "preinstalled"
  },
  "rubric": {
    "uri": "docs/RUBRIC-v0.md",
    "sha256": "ee4865b8cd19f6542f57053a24af2e46c8ab88498a925c3a349c83704dafe0a1",
    "version": "0.1.0",
    "media_type": "text/markdown"
  },
  "task_pack": {
    "uri": "pilots/three-cli-v0/protocol.json",
    "sha256": "f13ff7ee81ea7f663bcd5c0ec40d3bfae17600e1b8bd0344526dd268676d8add",
    "version": "0.1.0",
    "media_type": "application/json"
  },
  "environment": {
    "platforms": [
      {
        "os": "macOS 27.0",
        "architecture": "arm64",
        "shell": "zsh 5.9",
        "terminal": "non-interactive subprocess"
      }
    ],
    "execution_mode": "non_interactive",
    "isolation": "other",
    "network": {
      "mode": "allowlist",
      "allowed_hosts": [
        "api.github.com",
        "github.com",
        "cloud.dify.ai",
        "awire.samzong.workers.dev",
        "example.invalid"
      ]
    },
    "locale": "C.UTF-8",
    "timezone": "America/New_York"
  },
  "documentation": {
    "policy": "bundled",
    "evaluator_assistance": "protocol_only",
    "artifacts": []
  },
  "budgets": {
    "wall_time_seconds": 300,
    "max_commands": 20,
    "max_tool_calls": 30,
    "max_input_tokens": 200000,
    "max_output_tokens": 20000
  },
  "protocol": {
    "repetitions_per_task": 1,
    "warmup_trials": 0,
    "task_order": "fixed",
    "trial_reset": "clean_fixture",
    "capture": [
      "commands",
      "stdout",
      "stderr",
      "exit_status",
      "timing",
      "state_before",
      "state_after",
      "observations"
    ],
    "seed_policy": "unavailable"
  },
  "grader_policy": {
    "deterministic_first": true,
    "llm_judge": "forbidden",
    "double_rate_fraction": 0
  },
  "safety": {
    "sandbox_required": true,
    "fixture_only": true,
    "production_credentials": false,
    "outbound_network": "allowlist",
    "allowed_hosts": [
      "api.github.com",
      "github.com",
      "cloud.dify.ai",
      "awire.samzong.workers.dev",
      "example.invalid"
    ]
  },
  "agent": {
    "panel": [
      {
        "provider": "OpenAI",
        "model": "GPT-5",
        "model_version": "session-unreported",
        "agent": "Codex Desktop",
        "agent_version": "session-unreported",
        "parameters": {
          "subject_history": "present",
          "repetitions": 1
        }
      }
    ],
    "prompt": {
      "uri": "pilots/three-cli-v0/protocol.json",
      "sha256": "f13ff7ee81ea7f663bcd5c0ec40d3bfae17600e1b8bd0344526dd268676d8add",
      "version": "0.1.0",
      "media_type": "application/json"
    },
    "tool_surface": [
      "subprocess"
    ],
    "history_policy": "declared_carryover"
  }
}
